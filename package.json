{
  "name": "@open-rpc/test-coverage",
  "version": "0.0.0-development",
  "description": "Test your OpenRPC Document against an API.",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-rpc/test-coverage.git"
  },
  "scripts": {
    "lint": "bun --bun eslint src scripts",
    "test": "bun test --coverage && bun run lint && bun run typecheck",
    "typecheck": "bun --bun tsc --noEmit",
    "build": "bun scripts/build.ts && bun run build:types",
    "build:types": "bun --bun tsc -p tsconfig.build.json",
    "release": "bun --bun semantic-release"
  },
  "bin": {
    "open-rpc-test-coverage": "./bin/cli.js"
  },
  "files": [
    "bin",
    "build"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./build/*.js": {
      "types": "./build/*.d.ts",
      "import": "./build/*.js"
    }
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.14.0"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@open-rpc/html-reporter-react": "^0.0.4",
    "@open-rpc/schema-utils-js": "^2.2.1",
    "@types/lodash": "^4.14.162",
    "ajv": "^7.0.0",
    "colors": "^1.3.3",
    "commander": "^8.0.0",
    "json-schema-faker": "^0.5.0-rcv.29",
    "lodash": "^4.17.20"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "eslint": "^8.57.0",
    "semantic-release": "25.0.9",
    "typescript": "^5.4.4",
    "typescript-eslint": "^7.6.0"
  }
}
